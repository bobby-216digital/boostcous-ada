    "name": "Recipe Page Full",
    "settings": [
        {
            "type": "text",
            "id": "back-btn",
            "label":"Back Button"
        },
        {
            "type": "url",
            "id": "back-btn-link",
            "label":"Back Button Link"
        },
    ],
    "presets": [
        {
            "name": "Recipe Page Full"
        }
    ]
}
{% endschema %}
