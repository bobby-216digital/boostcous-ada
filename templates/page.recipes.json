        "text_EKTwnB": {
          "type": "text",
          "settings": {
            "text": "<p>At Boostcous, transparency matters. We’re committed to making clean, trustworthy products and sharing the standards behind them. Below you’ll find information about our glyphosate testing, kosher certification,  Non-GMO commitment, and gluten-free certification status.</p>"
          }
        }
